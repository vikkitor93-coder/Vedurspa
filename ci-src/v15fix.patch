+function parseLooseObject(text: string): Record<string, any> {
+  // Veðurstofa uses numeric station IDs as bare JavaScript object keys (e.g. {1:{...}}).
+  // JSON5 does not accept numeric property names, so quote only those keys before parsing.
+  const normalized = text.replace(/([,{]\s*)(\d+)\s*:/g, '$1\"$2\":');
+  return JSON5.parse(normalized) as Record<string, any>;
+}
