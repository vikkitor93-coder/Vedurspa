+import type { AuroraDayData, ForecastFrame } from '../types';
+import type { StationForecastData, StationForecastStation, StationHour } from './stationForecast';
+import { getNightKey, isWithinDarkness } from './auroraEvaluator';
+
+export interface LocationCloudEstimate {
+  percent: number;
+  sourceLabel: string;
+  nearestStation: string;
+  nearestDistanceKm: number;
+  matchedTimestamp: string;
+}
+
+export interface BestWeatherResult {
+  station: StationForecastStation;
+  hour: StationHour;
+  cloudPercent: number;
+  temperature: number;
+  score: number;
+}
+
+export interface BestAuroraFrameInfo {
+  frameIndex: number;
+  timeStr: string;
+  dayShort: string;
+  cloudPercent: number;
+  act: number;
+  isCurrentDark: boolean;
+}
+
+export function distanceKm(aLat: number, aLon: number, bLat: number, bLon: number): number {
+  const r = 6371;
+  const toRad = (v: number) => v * Math.PI / 180;
+  const dLat = toRad(bLat - aLat);
+  const dLon = toRad(bLon - aLon);
+  const q = Math.sin(dLat / 2) ** 2 + Math.cos(toRad(aLat)) * Math.cos(toRad(bLat)) * Math.sin(dLon / 2) ** 2;
+  return 2 * r * Math.atan2(Math.sqrt(q), Math.sqrt(1 - q));
+}
+
+export function normalizeCloud(value: number | null | undefined): number | null {
+  if (value == null || !Number.isFinite(value)) return null;
+  if (value >= 0 && value <= 1.0001) return Math.max(0, Math.min(100, value * 100));
+  if (value >= 0 && value <= 100) return value;
+  return null;
+}
+
+export function closestHour(station: StationForecastStation, targetIso: string): { hour: StationHour; diffMs: number } | null {
+  const target = Date.parse(targetIso);
+  if (!Number.isFinite(target) || !station.hours.length) return null;
+  let best = station.hours[0];
+  let diff = Math.abs(Date.parse(best.timestamp) - target);
+  for (let i = 1; i < station.hours.length; i++) {
+    const d = Math.abs(Date.parse(station.hours[i].timestamp) - target);
+    if (d < diff) { best = station.hours[i]; diff = d; }
+  }
+  return { hour: best, diffMs: diff };
+}
+
+function inferredCloudFromWeatherCode(code: number | null): number | null {
+  if (code == null) return null;
+  if (code === 1) return 3;
+  if (code === 2) return 25;
+  if (code === 3) return 65;
+  if (code === 4) return 95;
+  if ([5,6,7,8,9,10,11,12,13,17,18,19,20,21,22,23].includes(code)) return 90;
+  return 65;
+}
+
+export function cloudForStationHour(hour: StationHour): number | null {
+  return normalizeCloud(hour.cloudCover) ?? inferredCloudFromWeatherCode(hour.weatherCode);
+}
+
+export function estimateCloudAtLocation(
+  data: StationForecastData | null | undefined,
+  lat: number,
+  lon: number,
+  targetIso: string,
+): LocationCloudEstimate | null {
+  if (!data?.stations.length) return null;
+  const candidates = data.stations.flatMap(station => {
+    const match = closestHour(station, targetIso);
+    if (!match || match.diffMs > 4 * 60 * 60 * 1000) return [];
+    const cloud = cloudForStationHour(match.hour);
+    if (cloud == null) return [];
+    return [{ station, hour: match.hour, cloud, distance: distanceKm(lat, lon, station.lat, station.lon) }];
+  }).sort((a, b) => a.distance - b.distance).slice(0, 5);
+  if (!candidates.length) return null;
+
+  // A very nearby station/model point is the strongest evidence. Otherwise use
+  // inverse-distance weighting across nearby forecast points.
+  const nearest = candidates[0];
+  let weighted = 0;
+  let totalWeight = 0;
+  for (const c of candidates) {
+    const effectiveDistance = Math.max(6, c.distance);
+    const weight = 1 / Math.pow(effectiveDistance, 1.55);
+    weighted += c.cloud * weight;
+    totalWeight += weight;
+  }
+  let percent = totalWeight > 0 ? weighted / totalWeight : nearest.cloud;
+  if (nearest.distance <= 18) percent = nearest.cloud * 0.82 + percent * 0.18;
+
+  return {
+    percent: Math.max(0, Math.min(100, Math.round(percent))),
+    sourceLabel: nearest.distance <= 25 ? `${nearest.station.name} · staðaspá` : `${candidates.length} næstu stöðvar · staðaspá`,
+    nearestStation: nearest.station.name,
+    nearestDistanceKm: nearest.distance,
+    matchedTimestamp: nearest.hour.timestamp,
+  };
+}
+
+export function findBestWeatherStation(data: StationForecastData, targetIso: string): BestWeatherResult | null {
+  const rows = data.stations.flatMap(station => {
+    const match = closestHour(station, targetIso);
+    if (!match || match.diffMs > 4 * 60 * 60 * 1000 || match.hour.temperature == null) return [];
+    const cloud = cloudForStationHour(match.hour);
+    if (cloud == null) return [];
+    return [{ station, hour: match.hour, cloud, temp: match.hour.temperature }];
+  });
+  if (!rows.length) return null;
+
+  const minTemp = Math.min(...rows.map(r => r.temp));
+  const maxTemp = Math.max(...rows.map(r => r.temp));
+  const span = Math.max(1, maxTemp - minTemp);
+  let best: BestWeatherResult | null = null;
+  for (const row of rows) {
+    const clearScore = 1 - row.cloud / 100;
+    const warmScore = (row.temp - minTemp) / span;
+    // Clear sky is the dominant requirement; warmth breaks close calls.
+    const score = clearScore * 0.68 + warmScore * 0.32;
+    if (!best || score > best.score || (Math.abs(score - best.score) < 0.01 && row.temp > best.temperature)) {
+      best = { station: row.station, hour: row.hour, cloudPercent: Math.round(row.cloud), temperature: row.temp, score };
+    }
+  }
+  return best;
+}
+
+export function findBestAuroraFrameFromStations(
+  frames: ForecastFrame[],
+  startIndex: number,
+  auroraDays: Record<string, AuroraDayData> | undefined,
+  stationData: StationForecastData,
+  lat: number,
+  lon: number,
+): BestAuroraFrameInfo | null {
+  if (!frames.length) return null;
+  const end = Math.min(frames.length, startIndex + 36);
+  let best: { index: number; cloud: number; act: number; score: number } | null = null;
+
+  const consider = (i: number) => {
+    const frame = frames[i];
+    const { year, month, day, hour, minute } = frame.dateParts;
+    const dayData = auroraDays?.[getNightKey(year, month, day, hour)];
+    const dark = dayData?.hasDarkness
+      ? isWithinDarkness(hour, minute, dayData.darknessStart, dayData.darknessEnd)
+      : (hour >= 21 || hour <= 5);
+    if (!dark) return;
+    const estimate = estimateCloudAtLocation(stationData, lat, lon, frame.timestamp);
+    if (!estimate) return;
+    const act = dayData?.act ?? 2;
+    const score = (100 - estimate.percent) * 0.78 + (act / 9 * 100) * 0.22;
+    if (!best || score > best.score) best = { index: i, cloud: estimate.percent, act, score };
+  };
+
+  for (let i = Math.max(0, startIndex); i < end; i++) consider(i);
+  if (!best) for (let i = 0; i < Math.min(frames.length, 36); i++) consider(i);
+  if (!best) return null;
+
+  const winner = best as { index: number; cloud: number; act: number; score: number };
+  const frame = frames[winner.index];
+  const d = new Date(frame.timestamp);
+  const days = ['Sun','Mán','Þri','Mið','Fim','Fös','Lau'];
+  return {
+    frameIndex: winner.index,
+    timeStr: `${String(frame.dateParts.hour).padStart(2,'0')}:${String(frame.dateParts.minute).padStart(2,'0')}`,
+    dayShort: days[d.getUTCDay()] || '',
+    cloudPercent: winner.cloud,
+    act: winner.act,
+    isCurrentDark: winner.index === startIndex,
+  };
+}
