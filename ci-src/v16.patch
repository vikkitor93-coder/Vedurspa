+
+// Exact coordinate transform used by Veðurstofa's own Staðaspá/observation map
+// (VI.utils.CoordsConverter in vi-base.js). This is intentionally separate from
+// the HARMONIE/Lambert map transform above because wmap_isl.gif uses its own
+// polar map projection and dimensions.
+export function coordsToWmapPercent(lat: number, lon: number): { xPercent: number; yPercent: number } {
+  const dr = Math.PI / 180;
+  const llLat = 63.190, llLon = -24.150, trLat = 66.590, trLon = -12.950;
+  const lam0 = -19;
+  const width = 540, height = 390;
+  const t1 = Math.sin((45 - llLat / 2) * dr) / Math.cos((45 - llLat / 2) * dr);
+  const x1 = 2 * t1 * Math.sin((-llLon + lam0) * dr);
+  const y1 = -2 * t1 * Math.cos((-llLon + lam0) * dr);
+  const t2 = Math.sin((45 - trLat / 2) * dr) / Math.cos((45 - trLat / 2) * dr);
+  const x2 = 2 * t2 * Math.sin((-trLon + lam0) * dr);
+  const t = Math.sin((45 - lat / 2) * dr) / Math.cos((45 - lat / 2) * dr);
+  const xRaw = 2 * t * Math.sin((-lon + lam0) * dr);
+  const yRaw = -2 * t * Math.cos((-lon + lam0) * dr);
+  const x = Math.round(1 + (width - 1) * (xRaw - x1) / (x2 - x1));
+  const y = Math.round(1 + (width - 1) * (y1 - yRaw) / (x2 - x1));
+
+  // The original page positions markers using CSS `right`, so convert that to
+  // ordinary left-origin percentages for React/SVG overlays.
+  const rightPx = Math.abs(x - width);
+  const topPx = Math.abs(y - height);
+  const leftPx = width - rightPx;
+  return {
+    xPercent: Math.max(0, Math.min(100, leftPx / width * 100)),
+    yPercent: Math.max(0, Math.min(100, topPx / height * 100)),
+  };
+}
